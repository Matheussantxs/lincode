# Somente configuração local. Nunca inserir credenciais reais neste exemplo.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta APENAS para a RPC privada de rate limit; nunca usada nos dados dos usuários.
SUPABASE_RATE_LIMIT_KEY=
# 32 bytes aleatórios em base64; configure localmente ou nos Secrets da Vercel.
LINCODE_SESSION_SECRET=
# Origem exata do site; HTTPS obrigatório em produção.
APP_ORIGIN=http://127.0.0.1:8787
